# Builds the koje package (ADR 0045) on the distribution koje runs on:
# Ubuntu 26.04, so the package fits the host exactly.
# scripts/build-deb.sh (`just deb`) builds the image once and runs it; it
# works the same on the host and in the dev container.
FROM docker.io/library/ubuntu:26.04
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates curl git build-essential pkg-config rustup musl-tools \
    && rm -rf /var/lib/apt/lists/*
# The workspace's toolchain (rust-toolchain.toml), the static forwarder's
# target and cargo-deb.
COPY rust-toolchain.toml /tmp/toolchain/
RUN channel=$(sed -n 's/^channel *= *"\(.*\)"/\1/p' /tmp/toolchain/rust-toolchain.toml) \
    && rustup toolchain install "$channel" --profile minimal \
    && rustup default "$channel" \
    && rustup target add x86_64-unknown-linux-musl \
    && cargo install cargo-deb --locked \
    && rm -rf /root/.cargo/registry
