// Spike Waybar config with Lucide icons – generated by generate.py, do not edit.
// First draft of the bar configuration koje ships (M8.2, ADR 0020).
{
  "layer": "top",
  "position": "top",
  "height": 28,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "pulseaudio", "network", "battery", "tray"],

  "hyprland/workspaces": { "format": "{name}" },
  "hyprland/window": { "max-length": 60 },
  "clock": {
    "format": "\ue087  {:%H:%M}",                       // clock
    "format-alt": "\ue063  {:%a %d.%m.%Y}",          // calendar
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "cpu": { "format": "\ue0a9  {usage}%", "interval": 5 },     // cpu
  "memory": { "format": "\ue445  {percentage}%", "interval": 5 },  // memory-stick
  "pulseaudio": {
    "format": "\ue1ab  {volume}%",                    // volume-2
    "format-muted": "\ue1ac  muted",                   // volume-x
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": "\ue1ae  {essid}",                     // wifi
    "format-ethernet": "\ue620  {ipaddr}",       // ethernet-port
    "format-disconnected": "\ue1af  offline",          // wifi-off
    "tooltip-format": "{ifname} {ipaddr}/{cidr}"
  },
  "battery": {
    "format": "\ue053  {capacity}%",                   // battery
    "format-charging": "\ue054  {capacity}%"  // battery-charging
  },
  "tray": { "spacing": 8 }
}
