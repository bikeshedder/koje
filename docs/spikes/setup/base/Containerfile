# Throwaway base image for the M2 spikes – NOT the koje base image (that is M3.3).
# Build: docs/spikes/setup/build-base.sh (passes your user name and uid).
FROM registry.fedoraproject.org/fedora:44

# GUI programs and what they need on Wayland: GPU (mesa), sound (pipewire client
# tools), fonts. Podman + fuse-overlayfs for nested containers (M2.5).
# procps-ng/smem for memory measurements (M2.6).
RUN dnf -y install --setopt=install_weak_deps=False \
        firefox foot nautilus xdg-utils \
        mesa-dri-drivers mesa-vulkan-drivers libglvnd-egl glx-utils egl-utils \
        pipewire-utils pulseaudio-utils \
        dejavu-sans-fonts dejavu-sans-mono-fonts google-noto-emoji-fonts \
        podman podman-compose fuse-overlayfs slirp4netns passt shadow-utils \
        procps-ng smem which less dbus-daemon dbus-tools libcap \
        python3-gobject-base libnotify cups-client grim \
    && dnf clean all

# The host user exists in the image with the same name and uid, because the
# container runs with --userns=keep-id and the home is mounted at the host path.
ARG USER_NAME
ARG USER_UID
ARG USER_HOME
RUN useradd --uid "${USER_UID}" --home-dir "${USER_HOME}" --no-create-home "${USER_NAME}" \
    # Sub-ids for rootless Podman *inside* the container (M2.5): everything up to
    # 65535 except the user's own uid, like podman/stable (podman:1:999, podman:1001:64535).
    && printf '%s:1:%s\n%s:%s:%s\n' \
        "${USER_NAME}" "$((USER_UID - 1))" \
        "${USER_NAME}" "$((USER_UID + 1))" "$((65535 - USER_UID))" \
        | tee /etc/subuid > /etc/subgid

# newuidmap/newgidmap need their file capabilities (cap_setuid/cap_setgid). They
# were missing after the dnf install ("should have setuid or have filecaps").
# setuid root instead did not work ("write to uid_map failed: Operation not
# permitted"). podman/stable restores the capabilities, and that works on this host.
RUN rpm --restore shadow-utils && getcap /usr/bin/newuidmap /usr/bin/newgidmap

# Links opened inside the context go to the context's Firefox.
RUN mkdir -p /etc/xdg \
    && printf '[Default Applications]\nx-scheme-handler/http=firefox.desktop\nx-scheme-handler/https=firefox.desktop\ntext/html=firefox.desktop\n' \
        > /etc/xdg/mimeapps.list

# Inner Podman, modelled on quay.io/podman/stable (works on the host):
# - storage: overlay via fuse-overlayfs (no overlay-on-overlay)
# - cgroups disabled: the context owns the cgroup
# - default_sysctls = []: /proc/sys is read-only in the context
#   ("open /proc/sys/net/ipv4/ping_group_range: Read-only file system")
# - /proc bind-mounted: a fresh proc mount is refused while the context's /proc
#   is partly masked ("mount `proc` to `proc`: Operation not permitted")
# - utsns = "host": "sethostname: Operation not permitted" otherwise
# Networking stays private per inner container (pasta, /dev/net/tun).
COPY containers.conf /etc/containers/containers.conf
RUN printf '[storage]\ndriver = "overlay"\n[storage.options.overlay]\nmount_program = "/usr/bin/fuse-overlayfs"\n' \
        > /etc/containers/storage.conf

LABEL io.koje.spike=true
