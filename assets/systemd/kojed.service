# koje's background service (M4.7, ADR 0026/0027). Installed by the koje
# package to /usr/lib/systemd/user/ (ADR 0045); part of the koje session
# (koje-session.target, ADR 0048); a plain Hyprland session starts it through
# koje's legacy services.
[Unit]
Description=koje background service (window colors, contexts)
Documentation=https://github.com/bikeshedder/koje
PartOf=koje-session.target
After=koje-session.target

[Service]
Type=dbus
BusName=io.koje.Daemon
ExecStart=/usr/bin/kojed
Restart=on-failure
RestartSec=2
