# The koje session's services (ADR 0048): started by `koje session ready` once
# Hyprland runs, stopped by `koje session start` when it exits. Installed by
# the koje package to /usr/lib/systemd/user/.
[Unit]
Description=koje session
Documentation=https://github.com/bikeshedder/koje
BindsTo=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target
