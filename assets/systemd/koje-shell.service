# koje's UI: the bar, the OSD, dialogs, later notifications (ADR 0042). Holds
# no state of its own, so a restart after a crash costs only a moment without
# a bar. Installed by the koje package to /usr/lib/systemd/user/ (ADR 0045);
# part of the koje session (koje-session.target, ADR 0048).
[Unit]
Description=koje shell (bar)
Documentation=https://github.com/bikeshedder/koje
PartOf=koje-session.target
After=koje-session.target kojed.service

[Service]
Type=dbus
BusName=io.koje.Shell
ExecStart=/usr/bin/koje-shell
Restart=on-failure
RestartSec=1
