# The polkit authentication agent in the koje session (ADR 0048), until the
# shell has its own (M8.46). Its path differs between distributions.
# Installed by the koje package to /usr/lib/systemd/user/.
[Unit]
Description=koje session polkit agent
PartOf=koje-session.target
After=koje-session.target

[Service]
ExecStart=/bin/sh -c 'for a in /usr/libexec/polkit-gnome-authentication-agent-1 /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1; do [ -x "$a" ] && exec "$a"; done; echo "no polkit agent found" >&2; exit 1'
Restart=on-failure
RestartSec=5
