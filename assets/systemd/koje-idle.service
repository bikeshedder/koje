# Idle, blank and lock in the koje session (ADR 0048): hypridle. Installed by
# the koje package to /usr/lib/systemd/user/.
[Unit]
Description=koje session idle daemon (hypridle)
PartOf=koje-session.target
After=koje-session.target

[Service]
# Its own config: hypridle quits without one. hypridle 0.1.7 (Ubuntu 26.04)
# still looks for one in the XDG config dirs despite --config and throws when
# none is there, so /usr/share/koje/hypr/ is put first on XDG_CONFIG_DIRS.
ExecStart=/usr/bin/env XDG_CONFIG_DIRS=/usr/share/koje:${XDG_CONFIG_DIRS} /usr/bin/hypridle --config /usr/share/koje/hypr/hypridle.conf
Restart=on-failure
RestartSec=2
