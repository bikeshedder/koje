# Idle, blank and lock in the koje session (ADR 0048): hypridle. Installed by
# the koje package to /usr/lib/systemd/user/.
[Unit]
Description=koje session idle daemon (hypridle)
PartOf=koje-session.target
After=koje-session.target

[Service]
# Its own config: hypridle quits without one.
ExecStart=/usr/bin/hypridle --config /usr/share/koje/lock/hypridle.conf
Restart=on-failure
RestartSec=2
