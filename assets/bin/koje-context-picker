#!/bin/sh
# koje context picker (click on koje's bar module, Super+D outside a context):
# the running contexts with their memory in fuzzel, Enter switches to one.
# Installed by koje setup to ~/.local/lib/koje/. Until koje's own panel (M8).
set -eu
koje=${KOJE:-$HOME/.local/bin/koje}
line=$("$koje" bar --names --memory |
  fuzzel --dmenu --prompt 'context  ' --width 50 --lines 10) || exit 0
# "<context>  <memory>": the name is the first word.
ctx=${line%% *}
[ -n "$ctx" ] && exec "$koje" focus "$ctx"
