#!/bin/sh
# koje window picker (Super+Tab): every window in fuzzel, most recently used
# first; type to filter, Enter focuses the window – also on another workspace
# or in the stash. Installed by install.sh to ~/.local/lib/koje/.
# Until koje's own overview (M8).
set -eu
line=$(
  hyprctl -j clients |
    jq -r 'sort_by(.focusHistoryID) | .[] | select(.mapped)
           | "\(.class) – \(.title)   [\(.workspace.name)]   \(.address)"' |
    fuzzel --dmenu --prompt 'window  ' --width 90 --lines 15
) || exit 0
address=${line##* }
case "$address" in 0x*) ;; *) exit 0 ;; esac
hyprctl dispatch focuswindow "address:$address" >/dev/null
hyprctl dispatch alterzorder "top,address:$address" >/dev/null
