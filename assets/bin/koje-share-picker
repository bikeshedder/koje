#!/bin/sh
# xdph's screen sharing picker in the koje session (ADR 0050): koje-shell's,
# with the user's XDG_CONFIG_HOME back (xdph runs with koje's); xdph's own
# picker when koje-shell's fails. Prints the selection, nothing on cancel.
# Installed by the koje package to /usr/lib/koje/.
if [ -n "${KOJE_USER_CONFIG_HOME+set}" ]; then
  if [ -n "$KOJE_USER_CONFIG_HOME" ]; then
    export XDG_CONFIG_HOME="$KOJE_USER_CONFIG_HOME"
  else
    unset XDG_CONFIG_HOME
  fi
  unset KOJE_USER_CONFIG_HOME
fi
koje-shell share-picker "$@" && exit 0
echo "koje-share-picker: koje-shell failed, using hyprland-share-picker" >&2
exec hyprland-share-picker "$@"
